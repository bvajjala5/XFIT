# ─────────────────────────────────────────────────────────────────────────────
#  Uttar Fitness Admin Control Hub — local credentials
#  Copy this file to `.env` and fill it in. `.env` is git-ignored; never commit it.
# ─────────────────────────────────────────────────────────────────────────────
#
# This desktop app talks to Firebase with the **Admin SDK**, so it needs a
# service account (not the public web config used by the mobile app). A service
# account can read every user and change roles / disable accounts, so treat it
# like a password.
#
# How to get it:
#   1. Firebase console → ⚙️ Project settings → Service accounts
#   2. Click "Generate new private key" → download the JSON file
#   3. Copy the three values from that JSON into the variables below
#      (the private key keeps its \n escapes — paste it as one line, in quotes)
#
# The project id is safe to share; the other two are secrets.

FIREBASE_PROJECT_ID=xfit-723dd
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Alternatives (optional) ──────────────────────────────────────────────────
# Instead of the three values above you can point at the downloaded JSON file:
# FIREBASE_SERVICE_ACCOUNT=/absolute/path/to/serviceAccountKey.json
#
# …or use Google Application Default Credentials (e.g. after `gcloud auth
# application-default login`):
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/adc.json

# ── Analytics estimate (optional) ────────────────────────────────────────────
# Conservative Gemini-style rate used ONLY to estimate AI cost in the Analytics
# view. Never an invoice: exact billing/quota lives in Stripe/Gemini.
ADMIN_ANALYTICS_TOKEN_COST_PER_MILLION=0.075
# Lower this to cap collectionGroup reads in Analytics (default 20000, max 20000).
# ADMIN_ANALYTICS_MAX_DOCS=20000
