diff --git a/index.html b/index.html
index ab6b9e67..22863e61 100644
--- a/index.html
+++ b/index.html
@@ -4,7 +4,11 @@
 
     <meta charset="UTF-8" />
     <meta name="viewport" content="width=device-width, initial-scale=1.0" />
-    <title>XFIT | Free Fitness Tracker</title>
+    <title>Uttar Fitness | Free Fitness Tracker</title>
+    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
+    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
+    <meta name="apple-mobile-web-app-title" content="Uttar Fitness" />
+    <meta name="theme-color" content="#20212d" />
   </head>
   <body>
     <div id="root"></div>
diff --git a/public/firebase-messaging-sw.js b/public/firebase-messaging-sw.js
index 595cb18f..0693872f 100644
--- a/public/firebase-messaging-sw.js
+++ b/public/firebase-messaging-sw.js
@@ -9,10 +9,10 @@ self.addEventListener('message', event => {
 
     messaging.onBackgroundMessage(payload => {
       const { title, body, icon } = payload.notification ?? {};
-      self.registration.showNotification(title ?? 'XFit', {
+      self.registration.showNotification(title ?? 'Uttar Fitness', {
         body: body ?? '',
-        icon: icon ?? '/icon-192.png',
-        badge: '/icon-192.png',
+        icon: icon ?? '/icons/icon-192.png',
+        badge: '/icons/icon-192.png',
         data: payload.data,
       });
     });
