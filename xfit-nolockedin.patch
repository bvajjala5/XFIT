Subject: [PATCH] Hide Locked In from every workout list and redirect its old
 page

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_017FiLe6b8DYso7bCVHUN5VP
---
 src/pages/Home.jsx           | 2 +-
 src/pages/WeeklyPlan.jsx     | 2 +-
 src/pages/WorkoutDetail.jsx  | 3 ++-
 src/pages/Workouts.jsx       | 2 +-
 src/pages/WorkoutsAndRun.jsx | 2 +-
 5 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/src/pages/Home.jsx b/src/pages/Home.jsx
index 1f7f505a..f30b03b1 100644
--- a/src/pages/Home.jsx
+++ b/src/pages/Home.jsx
@@ -115,7 +115,7 @@ export default function Home() {
     queryKey: ['workouts'],
     queryFn: async () => {
       const snap = await getDocs(collection(db, 'workouts'))
-      return snap.docs.map(d => ({ id: d.id, ...d.data() }))
+      return snap.docs.map(d => ({ id: d.id, ...d.data() })).filter(w => w.id !== 'locked-in')
     },
   })
 
diff --git a/src/pages/WeeklyPlan.jsx b/src/pages/WeeklyPlan.jsx
index 2b0d1e5f..4e8234e7 100644
--- a/src/pages/WeeklyPlan.jsx
+++ b/src/pages/WeeklyPlan.jsx
@@ -65,7 +65,7 @@ export default function WeeklyPlan() {
   })
   const { data: library = [] } = useQuery({
     queryKey: ['workouts'],
-    queryFn: async () => (await getDocs(collection(db, 'workouts'))).docs.map((d) => ({ id: d.id, ...d.data() })),
+    queryFn: async () => (await getDocs(collection(db, 'workouts'))).docs.map((d) => ({ id: d.id, ...d.data() })).filter((w) => w.id !== 'locked-in'),
   })
 
   const refresh = () => Promise.all([qc.invalidateQueries({ queryKey: ['schedule', uid] }), qc.invalidateQueries({ queryKey: ['custom-workouts', uid] })])
diff --git a/src/pages/WorkoutDetail.jsx b/src/pages/WorkoutDetail.jsx
index a7b07d48..a95a7cd7 100644
--- a/src/pages/WorkoutDetail.jsx
+++ b/src/pages/WorkoutDetail.jsx
@@ -1,5 +1,5 @@
 import React, { useState, useEffect } from 'react';
-import { useParams, useNavigate } from 'react-router-dom';
+import { useParams, useNavigate, Navigate } from 'react-router-dom';
 import { db } from '@/lib/firebase';
 import { doc, getDoc } from 'firebase/firestore';
 import { useQuery } from '@tanstack/react-query';
@@ -127,6 +127,7 @@ export default function WorkoutDetail() {
       <div className="w-8 h-8 border-4 border-primary/20 border-t-primary rounded-full animate-spin" />
     </div>
   );
+  if (id === 'locked-in') return <Navigate to="/workouts" replace />;
   if (!workout) return (
     <div className="flex items-center justify-center min-h-screen text-muted-foreground">Workout not found</div>
   );
diff --git a/src/pages/Workouts.jsx b/src/pages/Workouts.jsx
index fe8a9f36..3970a909 100644
--- a/src/pages/Workouts.jsx
+++ b/src/pages/Workouts.jsx
@@ -26,7 +26,7 @@ export default function Workouts() {
     queryKey: ['workouts'],
     queryFn: async () => {
       const snap = await getDocs(query(collection(db, 'workouts'), orderBy('title')));
-      return snap.docs.map(d => ({ id: d.id, ...d.data() }));
+      return snap.docs.map(d => ({ id: d.id, ...d.data() })).filter(w => w.id !== 'locked-in');
     }
   });
 
diff --git a/src/pages/WorkoutsAndRun.jsx b/src/pages/WorkoutsAndRun.jsx
index cd1e9fdb..655e811e 100644
--- a/src/pages/WorkoutsAndRun.jsx
+++ b/src/pages/WorkoutsAndRun.jsx
@@ -27,7 +27,7 @@ export default function WorkoutsAndRun() {
     queryKey: ['workouts'],
     queryFn: async () => {
       const snap = await getDocs(collection(db, 'workouts'));
-      return snap.docs.map(d => ({ id: d.id, ...d.data() }));
+      return snap.docs.map(d => ({ id: d.id, ...d.data() })).filter(w => w.id !== 'locked-in');
     },
   });
 
