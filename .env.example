# Copy to .env and fill in. .env is git-ignored — never commit it.

# Firebase web config (Firebase console → Project settings → Your apps).
# These identify your project; they are protected by firestore.rules, not secrecy.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Your own Firebase Auth UID (Firebase console → Authentication → Users → "User UID"),
# NOT your API key. Only used to show the dev tools / seed the workout library.
# Real admin access is enforced in firestore.rules, not here.
VITE_DEV_UID=

# URL of your deployed AI proxy Worker (see worker/README.md). NO Gemini key goes in this app.
VITE_AI_PROXY_URL=
