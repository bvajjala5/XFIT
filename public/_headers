/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-98wouB9AvLT0N4P4rp76TA+naKAlm65tblk/nIoRDMg=' https://apis.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; manifest-src 'self'; connect-src 'self' https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firebaseinstallations.googleapis.com https://fcmregistrations.googleapis.com https://fcm.googleapis.com https://www.googleapis.com https://world.openfoodfacts.org https://tile.openstreetmap.org https://*.tile.openstreetmap.org https://*.workers.dev; frame-src 'self' https://accounts.google.com https://xfit-723dd.firebaseapp.com https://www.gstatic.com; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(self), microphone=(), geolocation=(self)

# The FCM service worker loads the official Firebase compat scripts from gstatic
# and talks to FCM endpoints, so it must not inherit the page CSP.
/firebase-messaging-sw.js
  ! Content-Security-Policy
  Cache-Control: no-cache

# The PWA worker must be revalidated so updates roll out promptly.
/sw.js
  Cache-Control: no-cache

# Static metadata is checked by agents and search crawlers.
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/.well-known/ard.json
  Content-Type: application/ard+json; charset=utf-8
  Cache-Control: public, max-age=3600

# Vite fingerprints these files, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=31536000, immutable
