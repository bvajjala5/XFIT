--- /dev/null
+++ b/worker/auth.js
@@ -0,0 +1,83 @@
+// Verifies a Firebase Auth ID token (RS256 JWT) using only WebCrypto — no dependencies.
+// Checks: signature (Google's rotating public keys), alg, aud, iss, exp, iat, sub.
+
+const JWKS_URL =
+  'https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com';
+
+let jwksCache = { keys: null, fetchedAt: 0 };
+const JWKS_TTL_MS = 60 * 60 * 1000;
+
+function b64urlToBytes(str) {
+  const b64 = str.replace(/-/g, '+').replace(/_/g, '/').padEnd(Math.ceil(str.length / 4) * 4, '=');
+  const bin = atob(b64);
+  return Uint8Array.from(bin, (c) => c.charCodeAt(0));
+}
+
+function parseJson(bytes) {
+  return JSON.parse(new TextDecoder().decode(bytes));
+}
+
+async function getJwks(fetchImpl = fetch) {
+  const now = Date.now();
+  if (jwksCache.keys && now - jwksCache.fetchedAt < JWKS_TTL_MS) return jwksCache.keys;
+  const res = await fetchImpl(JWKS_URL);
+  if (!res.ok) throw new Error('Could not load Firebase public keys');
+  const { keys } = await res.json();
+  jwksCache = { keys, fetchedAt: now };
+  return keys;
+}
+
+export function _resetJwksCache() {
+  jwksCache = { keys: null, fetchedAt: 0 };
+}
+
+/**
+ * @returns {Promise<{uid: string, claims: object}>} — throws Error on any failure.
+ */
+export async function verifyFirebaseToken(token, projectId, { fetchImpl = fetch, nowSec } = {}) {
+  if (!token || typeof token !== 'string') throw new Error('Missing token');
+  if (!projectId) throw new Error('Server misconfigured: no project id');
+
+  const parts = token.split('.');
+  if (parts.length !== 3) throw new Error('Malformed token');
+  const [h, p, s] = parts;
+
+  let header, payload;
+  try {
+    header = parseJson(b64urlToBytes(h));
+    payload = parseJson(b64urlToBytes(p));
+  } catch {
+    throw new Error('Malformed token');
+  }
+
+  if (header.alg !== 'RS256') throw new Error('Unsupported algorithm');
+  if (!header.kid) throw new Error('Missing key id');
+
+  const keys = await getJwks(fetchImpl);
+  const jwk = keys.find((k) => k.kid === header.kid);
+  if (!jwk) throw new Error('Unknown signing key');
+
+  const key = await crypto.subtle.importKey(
+    'jwk',
+    jwk,
+    { name: 'RSASSA-PKCS1-v1_5', hash: 'SHA-256' },
+    false,
+    ['verify']
+  );
+  const ok = await crypto.subtle.verify(
+    'RSASSA-PKCS1-v1_5',
+    key,
+    b64urlToBytes(s),
+    new TextEncoder().encode(`${h}.${p}`)
+  );
+  if (!ok) throw new Error('Bad signature');
+
+  const now = nowSec ?? Math.floor(Date.now() / 1000);
+  if (payload.aud !== projectId) throw new Error('Wrong audience');
+  if (payload.iss !== `https://securetoken.google.com/${projectId}`) throw new Error('Wrong issuer');
+  if (typeof payload.exp !== 'number' || payload.exp <= now) throw new Error('Token expired');
+  if (typeof payload.iat !== 'number' || payload.iat > now + 60) throw new Error('Token issued in the future');
+  if (!payload.sub || typeof payload.sub !== 'string') throw new Error('Missing subject');
+
+  return { uid: payload.sub, claims: payload };
+}
diff --git a/worker/auth.test.mjs b/worker/auth.test.mjs
new file mode 100644
index 00000000..2ae6fa8d
--- /dev/null
+++ b/worker/auth.test.mjs
@@ -0,0 +1,64 @@
+// Run: node --test worker/
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { verifyFirebaseToken, _resetJwksCache } from './auth.js';
+
+const PROJECT = 'demo-xfit';
+const b64u = (buf) => Buffer.from(buf).toString('base64url');
+
+async function makeKeyAndFetch() {
+  const kp = await crypto.subtle.generateKey(
+    { name: 'RSASSA-PKCS1-v1_5', modulusLength: 2048, publicExponent: new Uint8Array([1, 0, 1]), hash: 'SHA-256' },
+    true,
+    ['sign', 'verify']
+  );
+  const jwk = { ...(await crypto.subtle.exportKey('jwk', kp.publicKey)), kid: 'k1', alg: 'RS256', use: 'sig' };
+  const fetchImpl = async () => ({ ok: true, json: async () => ({ keys: [jwk] }) });
+  return { kp, fetchImpl };
+}
+
+async function sign(kp, payload, header = { alg: 'RS256', kid: 'k1', typ: 'JWT' }) {
+  const h = b64u(JSON.stringify(header));
+  const p = b64u(JSON.stringify(payload));
+  const sig = await crypto.subtle.sign('RSASSA-PKCS1-v1_5', kp.privateKey, new TextEncoder().encode(`${h}.${p}`));
+  return `${h}.${p}.${b64u(sig)}`;
+}
+
+const now = Math.floor(Date.now() / 1000);
+const good = { aud: PROJECT, iss: `https://securetoken.google.com/${PROJECT}`, sub: 'user123', iat: now - 5, exp: now + 3600 };
+
+test('accepts a valid token', async () => {
+  _resetJwksCache();
+  const { kp, fetchImpl } = await makeKeyAndFetch();
+  const r = await verifyFirebaseToken(await sign(kp, good), PROJECT, { fetchImpl });
+  assert.equal(r.uid, 'user123');
+});
+
+for (const [name, patch, msg] of [
+  ['wrong audience', { aud: 'other' }, /audience/],
+  ['wrong issuer', { iss: 'https://evil.example' }, /issuer/],
+  ['expired', { exp: now - 10 }, /expired/],
+  ['future iat', { iat: now + 1000 }, /future/],
+  ['missing sub', { sub: '' }, /subject/],
+]) {
+  test(`rejects ${name}`, async () => {
+    _resetJwksCache();
+    const { kp, fetchImpl } = await makeKeyAndFetch();
+    await assert.rejects(verifyFirebaseToken(await sign(kp, { ...good, ...patch }), PROJECT, { fetchImpl }), msg);
+  });
+}
+
+test('rejects a token signed by a different key', async () => {
+  _resetJwksCache();
+  const { fetchImpl } = await makeKeyAndFetch();
+  const { kp: attacker } = await makeKeyAndFetch();
+  await assert.rejects(verifyFirebaseToken(await sign(attacker, good), PROJECT, { fetchImpl }), /signature/);
+});
+
+test('rejects alg=none and garbage', async () => {
+  _resetJwksCache();
+  const { kp, fetchImpl } = await makeKeyAndFetch();
+  await assert.rejects(verifyFirebaseToken(await sign(kp, good, { alg: 'none', kid: 'k1' }), PROJECT, { fetchImpl }), /algorithm/);
+  await assert.rejects(verifyFirebaseToken('not.a.jwt', PROJECT, { fetchImpl }));
+  await assert.rejects(verifyFirebaseToken('', PROJECT, { fetchImpl }));
+});
diff --git a/worker/index.js b/worker/index.js
new file mode 100644
index 00000000..e3d5374f
--- /dev/null
+++ b/worker/index.js
@@ -0,0 +1,139 @@
+// XFit AI proxy — keeps the Gemini API key on the server and only serves signed-in XFit users.
+// Secrets/vars (see wrangler.toml + README):
+//   GEMINI_API_KEY      (secret)  your Google AI Studio key
+//   FIREBASE_PROJECT_ID (var)     your Firebase project id
+//   ALLOWED_ORIGINS     (var)     comma-separated list of allowed site origins
+//   GEMINI_MODEL        (var, optional) defaults to gemini-2.0-flash
+
+import { verifyFirebaseToken } from './auth.js';
+
+const MAX_BODY_CHARS = 30000;
+const MAX_MESSAGES = 20;
+const MAX_MESSAGE_CHARS = 6000;
+const MAX_SYSTEM_CHARS = 6000;
+const MAX_OUTPUT_TOKENS = 2000;
+
+// Best-effort per-isolate limiter (resets when the isolate recycles). For hard limits,
+// add Cloudflare's Rate Limiting rules in the dashboard for this Worker's route.
+const RATE_WINDOW_MS = 60_000;
+const RATE_MAX = 10;
+const hits = new Map();
+function rateLimited(uid) {
+  const now = Date.now();
+  const recent = (hits.get(uid) || []).filter((t) => now - t < RATE_WINDOW_MS);
+  if (recent.length >= RATE_MAX) {
+    hits.set(uid, recent);
+    return true;
+  }
+  recent.push(now);
+  hits.set(uid, recent);
+  if (hits.size > 5000) hits.clear();
+  return false;
+}
+
+function corsHeaders(origin, env) {
+  const allowed = (env.ALLOWED_ORIGINS || '').split(',').map((s) => s.trim()).filter(Boolean);
+  const ok = origin && allowed.includes(origin);
+  return {
+    ...(ok ? { 'Access-Control-Allow-Origin': origin } : {}),
+    'Access-Control-Allow-Methods': 'POST, OPTIONS',
+    'Access-Control-Allow-Headers': 'Content-Type, Authorization',
+    'Access-Control-Max-Age': '86400',
+    Vary: 'Origin',
+  };
+}
+
+function json(body, status, cors) {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json', ...cors },
+  });
+}
+
+// Gemini needs: first turn from the user, strictly alternating roles.
+function toGeminiContents(messages) {
+  const contents = messages
+    .filter((m) => m && typeof m.content === 'string' && m.content.trim())
+    .map((m) => ({
+      role: m.role === 'assistant' ? 'model' : 'user',
+      parts: [{ text: m.content.slice(0, MAX_MESSAGE_CHARS) }],
+    }));
+  if (contents.length === 0 || contents[0].role !== 'user') {
+    contents.unshift({ role: 'user', parts: [{ text: 'Hello' }] });
+  }
+  const fixed = [contents[0]];
+  for (let i = 1; i < contents.length; i++) {
+    if (contents[i].role === fixed[fixed.length - 1].role) {
+      fixed.push({ role: contents[i].role === 'user' ? 'model' : 'user', parts: [{ text: '...' }] });
+    }
+    fixed.push(contents[i]);
+  }
+  return fixed;
+}
+
+export default {
+  async fetch(request, env) {
+    const origin = request.headers.get('Origin');
+    const cors = corsHeaders(origin, env);
+
+    if (request.method === 'OPTIONS') return new Response(null, { status: 204, headers: cors });
+    if (request.method !== 'POST') return json({ error: 'Method not allowed' }, 405, cors);
+    if (!cors['Access-Control-Allow-Origin']) return json({ error: 'Origin not allowed' }, 403, cors);
+
+    // 1. Authenticate
+    const auth = request.headers.get('Authorization') || '';
+    const token = auth.startsWith('Bearer ') ? auth.slice(7) : '';
+    let uid;
+    try {
+      ({ uid } = await verifyFirebaseToken(token, env.FIREBASE_PROJECT_ID));
+    } catch {
+      return json({ error: 'Please sign in again.' }, 401, cors);
+    }
+
+    if (rateLimited(uid)) return json({ error: 'Too many requests — try again in a minute.' }, 429, cors);
+
+    // 2. Validate input
+    const raw = await request.text();
+    if (raw.length > MAX_BODY_CHARS) return json({ error: 'Request too large' }, 413, cors);
+    let body;
+    try {
+      body = JSON.parse(raw);
+    } catch {
+      return json({ error: 'Invalid JSON' }, 400, cors);
+    }
+    const { system, messages, maxTokens } = body || {};
+    if (!Array.isArray(messages) || messages.length === 0 || messages.length > MAX_MESSAGES) {
+      return json({ error: 'Invalid messages' }, 400, cors);
+    }
+    if (system != null && (typeof system !== 'string' || system.length > MAX_SYSTEM_CHARS)) {
+      return json({ error: 'Invalid system prompt' }, 400, cors);
+    }
+    const outTokens = Math.min(Math.max(parseInt(maxTokens, 10) || 1000, 1), MAX_OUTPUT_TOKENS);
+
+    if (!env.GEMINI_API_KEY) return json({ error: 'AI is not configured on the server.' }, 500, cors);
+
+    // 3. Call Gemini (key goes in a header, never in the URL)
+    const model = env.GEMINI_MODEL || 'gemini-2.0-flash';
+    const geminiRes = await fetch(
+      `https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent`,
+      {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json', 'x-goog-api-key': env.GEMINI_API_KEY },
+        body: JSON.stringify({
+          contents: toGeminiContents(messages),
+          ...(system && { system_instruction: { parts: [{ text: system }] } }),
+          generationConfig: { maxOutputTokens: outTokens, temperature: 0.7 },
+        }),
+      }
+    );
+
+    const data = await geminiRes.json().catch(() => ({}));
+    if (!geminiRes.ok) {
+      console.error('Gemini error', geminiRes.status, JSON.stringify(data?.error || {}));
+      return json({ error: 'The AI service had a problem. Try again shortly.' }, 502, cors);
+    }
+    const text = data.candidates?.[0]?.content?.parts?.[0]?.text || '';
+    if (!text) return json({ error: 'No response from AI' }, 502, cors);
+    return json({ text }, 200, cors);
+  },
+};
